# Public values only. Merge with the normal .env settings; never add credentials here.
# Validate this file before Compose interpolation; DOMAIN is one ASCII DNS FQDN.
DOMAIN=dictionary.example.org
SITE_CONFIG=./config/site.json
TRAEFIK_NETWORK=existing-traefik-public
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=existing-letsencrypt
# Must be unique within the existing Traefik Docker provider.
TRAEFIK_ROUTER_NAME=dictionary
