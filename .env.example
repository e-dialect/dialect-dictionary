# 运行参数模板：复制为.env；公开site.json不能填写真实密钥。
COMPOSE_PROJECT_NAME=dictionary-demo
SITE_CONFIG=./config/site.json
HTTP_PORT=18080
FEATURE_POLICY_DIRECTORY=./config
FEATURE_POLICY_FILE=feature-policy.example.json
SEED_DEMO=1
BACKEND_IMAGE=dialect-dictionary-candidate-backend:latest
WEBSITE_IMAGE=dialect-dictionary-candidate-website:latest
