#!/usr/bin/env python3
"""Small local entry point. No shell evaluation, deployment accounts or DNS changes."""
import sys
sys.dont_write_bytecode = True

import argparse
import importlib.util
import ipaddress
import uuid
import json
import os
from pathlib import Path
from urllib.parse import urlsplit
import re
import subprocess
import sys

ROOT = Path(__file__).resolve().parent

def fail(message):
    raise SystemExit(message)

def version_record():
    try:
        # An unpacked release may sit inside another checkout. Never attribute
        # that parent repository's commit/dirty state to this installation.
        top = subprocess.check_output(['git', 'rev-parse', '--show-toplevel'], cwd=ROOT, stderr=subprocess.DEVNULL, text=True).strip()
        if Path(top).resolve() != ROOT:
            raise OSError('Installation has no own Git worktree')
        commit = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT, stderr=subprocess.DEVNULL, text=True).strip()
        dirty = bool(subprocess.check_output(['git', 'status', '--porcelain'], cwd=ROOT).strip())
    except (OSError, subprocess.CalledProcessError):
        release = json.loads((ROOT / 'RELEASE.json').read_text()) if (ROOT / 'RELEASE.json').exists() else {}
        commit, dirty = release.get('sourceCommit', 'unknown'), None
    record = {'version': (ROOT / 'VERSION').read_text().strip(), 'sourceCommit': commit, 'sourceDirty': dirty, 'note': 'Installation source metadata; record actual runtime image IDs separately.'}
    (ROOT / 'config').mkdir(exist_ok=True)
    (ROOT / 'config/version.json').write_text(json.dumps(record, ensure_ascii=False, indent=2) + '\n')
    return record

def env_values(path):
    values = {}
    for line in path.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith('#'): continue
        key, sep, value = line.partition('=')
        if not sep: fail('配置行缺少等号：' + key)
        values[key.strip()] = value.strip().strip('\"\'')
    values.update({k: v for k, v in os.environ.items() if k in values})
    return values

def validate_instance(site_path, traefik=False, standalone=False):
    spec = importlib.util.spec_from_file_location('dictionary_public_config', ROOT / 'apps/backend/hinghwa-dict-backend/HinghwaDict/site_config.py')
    module = importlib.util.module_from_spec(spec); spec.loader.exec_module(module)
    try:
        config = module.load_config(site_path)
    except (OSError, ValueError) as error:
        fail(f'站点配置 {site_path}：{error}')
    if traefik:
        path = ROOT / ('.env.traefik-standalone' if standalone else '.env.traefik')
        if not path.exists(): fail('请按 docs/traefik.md 复制 .env.traefik.example 并填写域名/已有Traefik网络。')
        edge = env_values(path); domain = edge.get('DOMAIN', '')
        if not re.fullmatch(r'(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?', domain): fail('DOMAIN必须是小写ASCII域名，不含端口或表达式。')
        for key in ['TRAEFIK_NETWORK', 'TRAEFIK_ENTRYPOINT', 'TRAEFIK_CERTRESOLVER', 'TRAEFIK_ROUTER_NAME']:
            if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]*', edge.get(key, '')): fail('无效Traefik参数：' + key)
        if config['webUrl'].rstrip('/') != 'https://' + domain or config['mobileUrl'].rstrip('/') != 'https://' + domain + '/mobile': fail(f'{site_path} 的 webUrl/mobileUrl 必须与 DOMAIN 的 HTTPS 地址一致。')
        if standalone and edge.get('TRAEFIK_ENTRYPOINT') == 'web': fail('独立Traefik的HTTPS入口不能叫web，该名保留给HTTP跳转和挑战。')
        if standalone and not re.fullmatch(r'[^\s@]+@[^\s@]+\.[^\s@]+', edge.get('ACME_EMAIL', '')): fail('独立Traefik需要运营者自己的ACME_EMAIL；配置校验不会申请证书。')
        if config['apiBase'] not in ['/api', 'https://' + domain + '/api']: fail(f'{site_path} 的 apiBase 必须使用同域 /api 端点。')
    return config

def check_local_urls(site, port):
    for field in ('webUrl', 'mobileUrl'):
        url = urlsplit(site[field])
        try:
            local = ipaddress.ip_address(url.hostname).is_loopback
        except ValueError:
            local = url.hostname == 'localhost'
        effective_port = url.port or (443 if url.scheme == 'https' else 80)
        if local and str(effective_port) != str(port):
            print(f"提示：站点配置的 {field} 使用端口 {effective_port}，.env 的 HTTP_PORT 为 {port}。"
                  f"若使用本机直连，请同步修改站点配置的 {field} 或 HTTP_PORT。", file=sys.stderr)


def show_access_urls(compose, site, proxy):
    if proxy:
        web_url, mobile_url = site['webUrl'], site['mobileUrl']
    else:
        binding = subprocess.run(compose + ['port', 'website', '8080'], capture_output=True, text=True)
        address = binding.stdout.strip().splitlines()
        if binding.returncode or not address:
            print('网页入口尚无端口映射。请检查 website 服务状态。', file=sys.stderr)
            return
        web_url = 'http://' + address[0]
        mobile_url = web_url + '/mobile'
    print('电脑端：' + web_url.rstrip('/') + '/')
    print('手机端：' + mobile_url.rstrip('/') + '/')


def main():
    parser = argparse.ArgumentParser(description='词典：初始化、启动、资料包预览/导入、输入法词库导出和日常管理。')
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument('--traefik', action='store_true', help='复用已有Traefik')
    modes.add_argument('--traefik-standalone', action='store_true', help='仅新服务器：显式运行独立Traefik，详见docs/traefik.md')
    parser.add_argument('action', choices=['init', 'version', 'check', 'start', 'stop', 'preview', 'import', 'export-ime', 'manage'])
    args, rest = parser.parse_known_args()
    os.chdir(ROOT)
    use_proxy = args.traefik or args.traefik_standalone
    if args.action == 'init':
        for source, target in [('.env.example', '.env'), ('config/examples/coast.json', 'config/site.json')]:
            path = ROOT / target
            try:
                with path.open('x', encoding='utf-8') as output:
                    template = (ROOT / source).read_text()
                    if target == '.env':
                        project = 'dictionary-' + uuid.uuid4().hex[:12]
                        template = template.replace('COMPOSE_PROJECT_NAME=dictionary-demo', 'COMPOSE_PROJECT_NAME=' + project)
                        template += f'DICTIONARY_STANDALONE_PROJECT={project}-standalone\n'
                    output.write(template)
            except FileExistsError:
                print('保留已有配置：' + target)
        version_record(); print('已初始化。可先 ./dictionary preview 资料包路径，再 ./dictionary start。'); return
    if args.action == 'version': print(json.dumps(version_record(), ensure_ascii=False, indent=2)); return
    if args.action == 'preview':
        preview = argparse.ArgumentParser(prog='./dictionary preview', allow_abbrev=False,
                                          usage='%(prog)s 资料目录或.zip [--publish]')
        preview.add_argument('package', metavar='资料目录或.zip')
        preview.add_argument('--publish', action='store_true', help='检查包内公开授权声明')
        options = preview.parse_args(rest)
        spec = importlib.util.spec_from_file_location('resource_package_preview', ROOT / 'apps/backend/hinghwa-dict-backend/word/resource_packages.py')
        module = importlib.util.module_from_spec(spec); sys.modules[spec.name] = module; spec.loader.exec_module(module)
        plan = module.validate_package(Path(options.package), publish=options.publish)
        summary = module.preview_summary(plan)
        summary['previewMode'] = 'publish' if options.publish else 'private'
        print('公开导入前校验' if options.publish else '普通预览（默认私有导入）', file=sys.stderr)
        print(json.dumps(summary, ensure_ascii=False, indent=2))
        if plan.get('errors'): raise SystemExit(1)
        return
    if not (ROOT / '.env').is_file(): fail('请先执行 ./dictionary init')
    compose = ['docker', 'compose', '--env-file', '.env']
    if use_proxy: compose += ['--env-file', '.env.traefik-standalone' if args.traefik_standalone else '.env.traefik']
    compose += ['-f', 'compose.yaml']
    if use_proxy: compose += ['-f', 'ops/compose/traefik.yaml']
    if args.traefik_standalone: compose += ['-f', 'ops/compose/traefik-standalone.yaml']
    if os.environ.get('DICTIONARY_SUBNET'): compose += ['-f', 'ops/compose/network.yaml']
    config = json.loads(subprocess.check_output(compose + ['config', '--format', 'json'], text=True))
    project = config['name']
    volume = config['volumes']['dictionary-data']['name']
    website = config['services']['website']
    site_path = next(mount['source'] for mount in website['volumes'] if mount['target'] == '/config/site.json')
    if args.action != 'stop':
        site = validate_instance(site_path, use_proxy, args.traefik_standalone)
    if args.action in ('start', 'check', 'stop'):
        print(f'项目：{project}  安装目录：{ROOT}  数据卷：{volume}', flush=True)
        if not use_proxy and args.action != 'stop':
            port = website['ports'][0]['published']
            print(f'本机端口：{port}  站点配置：{site_path}', flush=True)
            check_local_urls(site, port)
    if args.action == 'check':
        return
    directories = subprocess.check_output([
        'docker', 'ps', '-a', '--filter', f'label=com.docker.compose.project={project}',
        '--format', '{{.Label "com.docker.compose.project.working_dir"}}',
    ], text=True).splitlines()
    for directory in set(directories):
        if directory and Path(directory).resolve() != ROOT:
            fail(f'项目 {project} 已用于 {directory}（卷 {volume}）。请在原目录管理它，或为新安装设置独立的 COMPOSE_PROJECT_NAME。')
    if args.action == 'start':
        if args.traefik_standalone:
            name = config['networks']['traefik']['name']
            names = subprocess.check_output(['docker', 'network', 'ls', '--format', '{{.Name}}'], text=True).splitlines()
            if name in names:
                network = json.loads(subprocess.check_output(['docker', 'network', 'inspect', name], text=True))[0]
                labels = network.get('Labels') or {}
                if labels.get('com.docker.compose.project') != config['name'] or labels.get('com.docker.compose.network') != 'traefik':
                    fail('TRAEFIK_NETWORK已存在且不属于本项目；请更换唯一名字，不接管已有网络。')
        version_record()
        command = compose + ['up', '-d', '--wait'] + (['--build'] if '--no-build' not in rest else []) + rest
    elif args.action == 'stop': command = compose + ['stop'] + rest
    elif args.action == 'export-ime':
        export_parser = argparse.ArgumentParser(description='导出已导入资料包的Pouleng附加词库')
        export_parser.add_argument('package_id')
        export_parser.add_argument('--mapping', required=True)
        export_parser.add_argument('--requester', required=True)
        export_parser.add_argument('--version', required=True)
        export_parser.add_argument('--include-private', action='store_true')
        export_parser.add_argument('--preview', action='store_true')
        export_parser.add_argument('--output')
        export_parser.add_argument('--authorization-statement')
        option = export_parser.parse_args(rest)
        mapping = Path(option.mapping)
        if mapping.is_symlink() or not mapping.is_file(): fail('输入码对照表须为普通文件。')
        mapping = mapping.resolve()
        if ':' in str(mapping): fail('Docker挂载路径不能包含冒号。')
        command = compose + ['run', '--rm', '--no-deps', '--entrypoint', 'python', '-v', str(mapping)+':/ime-codes.tsv:ro']
        if option.output:
            if option.preview: fail('预览不能同时写出文件。')
            if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]{0,115}\.zip', option.output): fail('--output填写不含目录的ASCII .zip文件名。')
            exports = ROOT / 'exports'
            if exports.is_symlink(): fail('exports目录不能是符号链接。')
            exports.mkdir(mode=0o700, exist_ok=True)
            if (exports/option.output).exists() or (exports/option.output).is_symlink(): fail('导出文件已存在，不覆盖。')
            command += ['-v', str(exports)+':/export-output']
        command += ['backend', '/app/manage-command.py', 'export_ime_dictionary', option.package_id, '--mapping', '/ime-codes.tsv', '--requester', option.requester, '--export-version', option.version]
        if option.include_private: command += ['--include-private']
        if option.preview: command += ['--preview']
        if option.output: command += ['--output', '/export-output/'+option.output]
        if option.authorization_statement: command += ['--authorization-statement', option.authorization_statement]
    elif args.action == 'manage':
        command = compose + ['run', '--rm', '--no-deps', '--entrypoint', 'python', 'backend', '/app/manage-command.py'] + rest
    else:
        if not rest: fail('用法：./dictionary import 资料包路径 --importer 已有用户名 [--publish]')
        path = Path(rest[0])
        if path.is_symlink(): fail('资料包根不能是符号链接。')
        path = path.resolve(strict=True)
        if ':' in str(path): fail('Docker挂载路径不能包含冒号。')
        destination = '/import-package.zip' if path.is_file() else '/import-package'
        command = compose + ['run', '--rm', '--no-deps', '--entrypoint', 'python', '-v', str(path) + ':' + destination + ':ro', 'backend', '/app/manage-command.py', 'import_resource_package', destination, '--apply'] + rest[1:]
    subprocess.run(command, check=True)
    if args.action == 'start':
        show_access_urls(compose, site, use_proxy)

if __name__ == '__main__':
    try: main()
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        fail('操作失败：' + str(error))
