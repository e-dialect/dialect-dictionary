# 仅无代理的新服务器使用：复制为.env.traefik-standalone并填写自己的参数。
COMPOSE_PROJECT_NAME=dictionary-standalone
SITE_CONFIG=./config/site.json
DOMAIN=dictionary.example.org
TRAEFIK_NETWORK=dictionary-standalone-ingress
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=dictionary-acme
TRAEFIK_ROUTER_NAME=dictionary-standalone
# 必填：运营者自己的注册邮箱；模板故意留空，校验不会代为注册。
ACME_EMAIL=
